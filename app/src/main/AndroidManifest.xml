<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <queries>
        <!-- Clock Intents & Packages -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.android.deskclock" />
        <package android:name="com.sec.android.app.clockpackage" />
        <package android:name="com.coloros.alarmclock" />
        <package android:name="com.oplus.alarmclock" />
        <package android:name="com.vivo.alarmclock" />

        <!-- Weather Packages -->
        <package android:name="com.miui.weather2" />
        <package android:name="com.sec.android.daemonapp" />
        <package android:name="com.coloros.weather" />
        <package android:name="com.oplus.weather" />
        <package android:name="com.huawei.android.totemweather" />
        <package android:name="com.google.android.apps.weather" />
        <package android:name="com.vivo.weather" />

        <!-- Maps Intents & Packages -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:name=".MaterialThemesApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialThemes">
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MaterialThemes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.WidgetEditActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialThemes" />

        <activity
            android:name=".ui.WidgetPresetsActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialThemes" />

        <activity
            android:name=".ui.WidgetPresetEditActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialThemes" />

        <!-- Widget Quick Configure Bottom Sheet Activity -->
        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.MaterialThemes.TranslucentBottomSheet">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Widget Multi-Zone Click Router Activity -->
        <activity
            android:name=".widget.WidgetClickRouterActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- Diagonal Widget Provider (2x2) -->
        <receiver
            android:name=".widget.DiagonalWidgetProvider"
            android:exported="true"
            android:label="@string/widget_diagonal_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.iatb.materialthemes.ACTION_WIDGET_TICK" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.WALLPAPER_CHANGED" />
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/diagonal_widget_info" />
        </receiver>

        <!-- Diagonal 4x3 Multi-block Forecast Widget Provider -->
        <receiver
            android:name=".widget.Diagonal4x3WidgetProvider"
            android:exported="true"
            android:label="@string/widget_diagonal_4x3_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.iatb.materialthemes.ACTION_WIDGET_TICK" />
                <action android:name="android.intent.action.WALLPAPER_CHANGED" />
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/diagonal_4x3_widget_info" />
        </receiver>

        <!-- Organic Shapes Widget Provider (2x2) -->
        <receiver
            android:name=".widget.OrganicWidgetProvider"
            android:exported="true"
            android:label="@string/widget_organic_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.iatb.materialthemes.ACTION_WIDGET_TICK" />
                <action android:name="android.intent.action.WALLPAPER_CHANGED" />
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
            </intent-filter>

            <meta-data
