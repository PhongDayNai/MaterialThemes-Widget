<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/battery_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Ambient Mesh Gradient Background -->
    <com.iatb.materialthemes.ui.AmbientMeshBackgroundView
        android:id="@+id/ambient_bg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/battery_detail_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="22dp"
            android:paddingBottom="56dp">

            <!-- Top Header with Back Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btn_back"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/shape_circle"
                    android:backgroundTint="#26FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#FFFFFF" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/battery_detail_screen_title"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/battery_detail_screen_subtitle"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- LIVE PREVIEW HEADER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.04"
                android:text="@string/battery_preview_title"
                android:textColor="#E0FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.iatb.materialthemes.ui.GlassBlurCardView
                android:id="@+id/card_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:id="@+id/container_battery_preview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="80dp" />
                </LinearLayout>
            </com.iatb.materialthemes.ui.GlassBlurCardView>

            <!-- COLOR & OPACITY CONFIGURATION CARD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.04"
                android:text="@string/theme_section_title"
                android:textColor="#E0FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.iatb.materialthemes.ui.GlassBlurCardView
                android:id="@+id/card_color_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Follow Clock & Weather Switch Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/battery_section_sync_title"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_sync_status_desc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/battery_section_sync_desc"
                                android:textColor="#B3FFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_follow_clock_weather"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <!-- Separate Color Palette & Opacity Picker (Hidden when Following Clock & Weather) -->
                    <LinearLayout
                        android:id="@+id/layout_palette_picker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="14dp"
                            android:background="#20FFFFFF" />

                        <!-- Palette Swatches -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <!-- DYNAMIC -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/swatch_dynamic"
                                    android:layout_width="84dp"
                                    android:layout_height="100dp"
                                    android:layout_marginEnd="10dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@android:color/transparent"
                                    app:strokeWidth="2dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="6dp">

                                        <FrameLayout
                                            android:layout_width="46dp"
                                            android:layout_height="46dp"
                                            android:background="@drawable/bg_dynamic_palette_badge">

                                            <ImageView
                                                android:layout_width="22dp"
                                                android:layout_height="22dp"
                                                android:layout_gravity="center"
                                                android:contentDescription="@null"
                                                android:src="@drawable/ic_auto_awesome"
                                                app:tint="#FFFFFF" />
                                        </FrameLayout>

                                        <TextView
                                            android:id="@+id/tv_label_swatch_dynamic"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:text="@string/theme_dynamic"
                                            android:textColor="#FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                                <!-- CUSTOM COLOR PICKER -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/swatch_custom_picker"
                                    android:layout_width="84dp"
                                    android:layout_height="100dp"
                                    android:layout_marginEnd="10dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@android:color/transparent"
                                    app:strokeWidth="2dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="6dp">

                                        <FrameLayout
                                            android:layout_width="46dp"
                                            android:layout_height="46dp"
                                            android:background="@drawable/bg_picker_palette_badge">

                                            <ImageView
                                                android:id="@+id/disc_swatch_custom"
                                                android:layout_width="22dp"
                                                android:layout_height="22dp"
                                                android:layout_gravity="center"
                                                android:contentDescription="@null"
                                                android:src="@drawable/ic_color_lens"
                                                app:tint="#FFFFFF" />
                                        </FrameLayout>

                                        <TextView
                                            android:id="@+id/tv_label_swatch_custom"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:text="@string/theme_custom"
                                            android:textColor="#FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                                <!-- OLIVE -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/swatch_olive"
                                    android:layout_width="84dp"
                                    android:layout_height="100dp"
                                    android:layout_marginEnd="10dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@android:color/transparent"
                                    app:strokeWidth="2dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="6dp">

                                        <ImageView
                                            android:id="@+id/disc_swatch_olive"
                                            android:layout_width="46dp"
                                            android:layout_height="46dp"
                                            android:contentDescription="@null" />

                                        <TextView
                                            android:id="@+id/tv_label_swatch_olive"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:text="@string/theme_olive"
                                            android:textColor="#FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                                <!-- TEAL -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/swatch_teal"
                                    android:layout_width="84dp"
                                    android:layout_height="100dp"
                                    android:layout_marginEnd="10dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@android:color/transparent"
                                    app:strokeWidth="2dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="6dp">

                                        <ImageView
                                            android:id="@+id/disc_swatch_teal"
                                            android:layout_width="46dp"
                                            android:layout_height="46dp"
                                            android:contentDescription="@null" />

                                        <TextView
                                            android:id="@+id/tv_label_swatch_teal"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:text="@string/theme_teal"
                                            android:textColor="#FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                                <!-- SLATE -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/swatch_slate"
                                    android:layout_width="84dp"
                                    android:layout_height="100dp"
                                    android:layout_marginEnd="10dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@android:color/transparent"
                                    app:strokeWidth="2dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="6dp">

                                        <ImageView
                                            android:id="@+id/disc_swatch_slate"
                                            android:layout_width="46dp"
                                            android:layout_height="46dp"
                                            android:contentDescription="@null" />

                                        <TextView
                                            android:id="@+id/tv_label_swatch_slate"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:text="@string/theme_slate"
                                            android:textColor="#FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                                <!-- AMBER -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/swatch_amber"
                                    android:layout_width="84dp"
                                    android:layout_height="100dp"
                                    android:layout_marginEnd="10dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@android:color/transparent"
                                    app:strokeWidth="2dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="6dp">

                                        <ImageView
                                            android:id="@+id/disc_swatch_amber"
                                            android:layout_width="46dp"
                                            android:layout_height="46dp"
                                            android:contentDescription="@null" />

                                        <TextView
                                            android:id="@+id/tv_label_swatch_amber"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:text="@string/theme_amber"
                                            android:textColor="#FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                                <!-- CRIMSON -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/swatch_crimson"
                                    android:layout_width="84dp"
                                    android:layout_height="100dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@android:color/transparent"
                                    app:strokeWidth="2dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="6dp">

                                        <ImageView
                                            android:id="@+id/disc_swatch_crimson"
                                            android:layout_width="46dp"
                                            android:layout_height="46dp"
                                            android:contentDescription="@null" />

                                        <TextView
                                            android:id="@+id/tv_label_swatch_crimson"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:text="@string/theme_crimson"
                                            android:textColor="#FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>
                            </LinearLayout>
                        </HorizontalScrollView>

                        <!-- Opacity Slider Section -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/transparency_section_title"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_transparency_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/slider_transparency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:stepSize="5.0"
                            android:value="100.0"
                            android:valueFrom="0.0"
                            android:valueTo="100.0" />

                    </LinearLayout>
                </LinearLayout>
            </com.iatb.materialthemes.ui.GlassBlurCardView>

            <!-- BLUETOOTH ACCESSORIES CARD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.04"
                android:text="@string/battery_bluetooth_permission_title"
                android:textColor="#E0FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.iatb.materialthemes.ui.GlassBlurCardView
                android:id="@+id/card_bluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/shape_circle"
                        android:backgroundTint="#26FFFFFF">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bluetooth"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_bluetooth_status_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/battery_bluetooth_permission_title"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_bluetooth_status_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/battery_bluetooth_permission_desc"
                            android:textColor="#B3FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_grant_bluetooth"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/battery_bluetooth_grant_btn"
                        android:textSize="12sp"
                        android:visibility="visible" />
                </LinearLayout>
            </com.iatb.materialthemes.ui.GlassBlurCardView>

            <!-- BATTERY PREDICTION & USAGE STATS CARD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.04"
                android:text="@string/battery_prediction_section_title"
                android:textColor="#E0FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.iatb.materialthemes.ui.GlassBlurCardView
                android:id="@+id/card_battery_prediction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/shape_circle"
                        android:backgroundTint="#26FFFFFF">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_auto_awesome"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_prediction_status_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/battery_prediction_title"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_prediction_status_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/battery_prediction_desc"
                            android:textColor="#B3FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_grant_prediction"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/battery_prediction_grant_btn"
                        android:textSize="12sp"
                        android:visibility="visible" />
                </LinearLayout>
            </com.iatb.materialthemes.ui.GlassBlurCardView>

            <!-- PIN WIDGET ACTION BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pin_battery_widget"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:letterSpacing="0.02"
                android:text="@string/battery_pin_widget"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_push_pin"
                app:iconGravity="textStart"
                app:iconPadding="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/resize_tip"
                android:textColor="#80FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
