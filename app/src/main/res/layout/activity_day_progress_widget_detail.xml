<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/day_progress_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Ambient Mesh Gradient Background -->
    <com.iatb.materialthemes.ui.AmbientMeshBackgroundView
        android:id="@+id/ambient_bg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/day_progress_detail_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="22dp"
            android:paddingBottom="56dp">

            <!-- Top Header with Back Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btn_back"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/shape_circle"
                    android:backgroundTint="#26FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#FFFFFF" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/day_progress_detail_screen_title"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/day_progress_detail_screen_subtitle"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- LIVE PREVIEW HEADER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.04"
                android:text="@string/battery_preview_title"
                android:textColor="#E0FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- PREVIEW CARD -->
            <com.iatb.materialthemes.ui.GlassBlurCardView
                android:id="@+id/card_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:id="@+id/container_day_progress_preview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <FrameLayout
                            android:id="@+id/fl_preview_host"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center" />
                    </FrameLayout>
                </LinearLayout>
            </com.iatb.materialthemes.ui.GlassBlurCardView>

            <!-- SECTION 1: COLOR PALETTE & OPACITY CONFIG -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.04"
                android:text="@string/section_palette_title"
                android:textColor="#E0FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.iatb.materialthemes.ui.GlassBlurCardView
                android:id="@+id/card_color_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="18dp">

                    <!-- Follow Clock & Weather Switch Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/shape_circle"
                            android:backgroundTint="#20FFFFFF">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_style"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/battery_section_sync_title"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_sync_status_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/battery_section_sync_desc"
                                android:textColor="#B3FFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_follow_clock_weather"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <!-- Separate Color Palette & Opacity Picker (Hidden when Following Clock & Weather) -->
                    <LinearLayout
                        android:id="@+id/layout_palette_picker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="14dp"
                            android:background="#20FFFFFF" />

                        <!-- Palette Swatches -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <!-- DYNAMIC -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/swatch_dynamic"
                                    android:layout_width="84dp"
                                    android:layout_height="100dp"
                                    android:layout_marginEnd="10dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@android:color/transparent"
                                    app:strokeWidth="2dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="6dp">

                                        <FrameLayout
                                            android:layout_width="46dp"
                                            android:layout_height="46dp"
                                            android:background="@drawable/bg_dynamic_palette_badge">

                                            <ImageView
                                                android:layout_width="22dp"
                                                android:layout_height="22dp"
                                                android:layout_gravity="center"
                                                android:contentDescription="@null"
                                                android:src="@drawable/ic_auto_awesome"
                                                app:tint="#FFFFFF" />
                                        </FrameLayout>

                                        <TextView
                                            android:id="@+id/tv_label_swatch_dynamic"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:text="@string/theme_dynamic"
                                            android:textColor="#FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                                <!-- CUSTOM COLOR PICKER -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/swatch_custom_picker"
                                    android:layout_width="84dp"
                                    android:layout_height="100dp"
                                    android:layout_marginEnd="10dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@android:color/transparent"
                                    app:strokeWidth="2dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="6dp">

                                        <FrameLayout
                                            android:layout_width="46dp"
                                            android:layout_height="46dp"
                                            android:background="@drawable/bg_picker_palette_badge">

                                            <ImageView
                                                android:id="@+id/disc_swatch_custom"
                                                android:layout_width="22dp"
                                                android:layout_height="22dp"
                                                android:layout_gravity="center"
                                                android:contentDescription="@null"
                                                android:src="@drawable/ic_color_lens"
                                                app:tint="#FFFFFF" />
                                        </FrameLayout>

                                        <TextView
                                            android:id="@+id/tv_label_swatch_custom"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:text="@string/theme_custom"
                                            android:textColor="#FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                                <!-- OLIVE -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/swatch_olive"
                                    android:layout_width="84dp"
                                    android:layout_height="100dp"
                                    android:layout_marginEnd="10dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@android:color/transparent"
                                    app:strokeWidth="2dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="6dp">

                                        <ImageView
                                            android:id="@+id/disc_swatch_olive"
                                            android:layout_width="46dp"
                                            android:layout_height="46dp"
                                            android:contentDescription="@null" />

                                        <TextView
                                            android:id="@+id/tv_label_swatch_olive"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:text="@string/theme_olive"
                                            android:textColor="#FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                                <!-- TEAL -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/swatch_teal"
                                    android:layout_width="84dp"
                                    android:layout_height="100dp"
                                    android:layout_marginEnd="10dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@android:color/transparent"
                                    app:strokeWidth="2dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="6dp">

                                        <ImageView
                                            android:id="@+id/disc_swatch_teal"
                                            android:layout_width="46dp"
                                            android:layout_height="46dp"
                                            android:contentDescription="@null" />

                                        <TextView
                                            android:id="@+id/tv_label_swatch_teal"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:text="@string/theme_teal"
                                            android:textColor="#FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                                <!-- SLATE -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/swatch_slate"
                                    android:layout_width="84dp"
                                    android:layout_height="100dp"
                                    android:layout_marginEnd="10dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@android:color/transparent"
                                    app:strokeWidth="2dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="6dp">

                                        <ImageView
                                            android:id="@+id/disc_swatch_slate"
                                            android:layout_width="46dp"
                                            android:layout_height="46dp"
                                            android:contentDescription="@null" />

                                        <TextView
                                            android:id="@+id/tv_label_swatch_slate"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:text="@string/theme_slate"
                                            android:textColor="#FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                                <!-- AMBER -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/swatch_amber"
                                    android:layout_width="84dp"
                                    android:layout_height="100dp"
                                    android:layout_marginEnd="10dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@android:color/transparent"
                                    app:strokeWidth="2dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="6dp">

                                        <ImageView
                                            android:id="@+id/disc_swatch_amber"
                                            android:layout_width="46dp"
                                            android:layout_height="46dp"
                                            android:contentDescription="@null" />

                                        <TextView
                                            android:id="@+id/tv_label_swatch_amber"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:text="@string/theme_amber"
                                            android:textColor="#FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                                <!-- CRIMSON -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/swatch_crimson"
                                    android:layout_width="84dp"
                                    android:layout_height="100dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@android:color/transparent"
                                    app:strokeWidth="2dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="6dp">

                                        <ImageView
                                            android:id="@+id/disc_swatch_crimson"
                                            android:layout_width="46dp"
                                            android:layout_height="46dp"
                                            android:contentDescription="@null" />

                                        <TextView
                                            android:id="@+id/tv_label_swatch_crimson"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:text="@string/theme_crimson"
                                            android:textColor="#FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>
                            </LinearLayout>
                        </HorizontalScrollView>

                        <!-- Opacity Slider Section -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/transparency_section_title"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_transparency_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="100%"
                                    android:textColor="#80D8FF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <com.google.android.material.slider.Slider
                                android:id="@+id/slider_transparency"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:stepSize="5"
                                android:value="100"
                                android:valueFrom="0"
                                android:valueTo="100" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.iatb.materialthemes.ui.GlassBlurCardView>

            <!-- SECTION 2: DAY STATISTICS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.04"
                android:text="@string/day_progress_stats_section_title"
                android:textColor="#E0FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.iatb.materialthemes.ui.GlassBlurCardView
                android:id="@+id/card_day_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="18dp">

                    <!-- Stat 1: Elapsed Time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/day_progress_stat_elapsed"
                            android:textColor="#B3FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_stat_elapsed_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15h 58m / 24h"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="#1AFFFFFF" />

                    <!-- Stat 2: Timezone -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/day_progress_stat_timezone"
                            android:textColor="#B3FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_stat_timezone_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Asia/Ho_Chi_Minh (GMT+07:00)"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="#1AFFFFFF" />

                    <!-- Stat 3: DST -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/day_progress_stat_dst"
                            android:textColor="#B3FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_stat_dst_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/day_progress_dst_inactive"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.iatb.materialthemes.ui.GlassBlurCardView>

            <!-- PIN TO HOME SCREEN BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pin_widget"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="?attr/colorPrimary"
                android:text="@string/day_progress_pin_widget"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_style"
                app:iconGravity="textStart"
                app:iconTint="#000000" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
