<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/presets_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Random Ambient Mesh Background for Presets Screen -->
    <com.iatb.materialthemes.ui.AmbientMeshBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/presets_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- Top Bar with Back Arrow and Add Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btn_back_presets"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/presets_screen_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_apply_preset_header"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/button_quick_apply"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_check"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- Live Preview Stage in Presets Screen (Spacious, No Clipping, NO rectangular shadow artifact) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_preview"
                    android:layout_width="match_parent"
                    android:layout_height="235dp"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="@color/glass_card_bg"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_card_stroke"
                    app:strokeWidth="1.5dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/iv_preview_wallpaper"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/bg_preview_wallpaper" />

                        <FrameLayout
                            android:id="@+id/preview_container"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/quick_presets_section_subtitle"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <!-- 2-Column Grid of Presets -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_presets_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- Floating Tab & Drag Handle Assembly on Right Edge -->
    <LinearLayout
        android:id="@+id/container_floating_tab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="260dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="2dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <!-- Floating Bookmark / Sticky Note Tab Badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/badge_sticky_tab"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="0dp"
            app:cardElevation="6dp"
            app:cardMaxElevation="10dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- Add Preset Button -->
                <ImageButton
                    android:id="@+id/btn_badge_add"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/badge_add_preset"
                    android:src="@drawable/ic_auto_awesome"
                    app:tint="?attr/colorPrimary" />

                <!-- Edit Selected Preset Button Container (Smooth height expand/collapse) -->
                <FrameLayout
                    android:id="@+id/container_badge_edit"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:clipChildren="false"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btn_badge_edit"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginEnd="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/badge_edit_preset"
                        android:src="@drawable/ic_edit"
                        app:tint="?attr/colorPrimary" />
                </FrameLayout>

                <!-- Delete Selected Preset Button Container (Smooth height expand/collapse) -->
                <FrameLayout
                    android:id="@+id/container_badge_delete"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:clipChildren="false"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btn_badge_delete"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginEnd="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_delete"
                        android:src="@drawable/ic_delete"
                        app:tint="?attr/colorError" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Circular Drag Button 8dp below the badge, outside of the badge card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_badge_drag"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:contentDescription="@string/badge_drag_handle"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="23dp"
            app:cardElevation="6dp"
            app:cardMaxElevation="10dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <com.iatb.materialthemes.ui.AnimatedFingerprintView
                android:id="@+id/fingerprint_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</FrameLayout>
