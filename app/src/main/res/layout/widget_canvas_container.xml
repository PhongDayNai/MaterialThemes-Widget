<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_diagonal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Lớp đồ họa dựng Canvas -->
    <ImageView
        android:id="@+id/iv_canvas_render"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@string/widget_diagonal_name"
        android:scaleType="fitCenter" />

    <!-- Lớp cảm ứng 2x2 hoặc 1 khối (FrameLayout an toàn cho RemoteViews) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Nửa trên (Clock trong combo) -->
        <FrameLayout
            android:id="@+id/touch_zone_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent" />

        <!-- Nửa dưới (Weather trong combo) -->
        <FrameLayout
            android:id="@+id/touch_zone_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent" />
    </LinearLayout>

</FrameLayout>
