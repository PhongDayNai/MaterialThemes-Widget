<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_diagonal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Lớp đồ họa dựng Canvas -->
    <ImageView
        android:id="@+id/iv_canvas_render"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@string/widget_diagonal_name"
        android:scaleType="fitCenter" />

    <!-- Lớp cảm ứng 3 khối: 2 khối trên (weight 1.2) và 1 dải dưới full width (weight 0.8) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Hàng Trên: 2 khối Trái và Phải -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:orientation="horizontal">

            <!-- Khối 1: Trái trên (Clock) -->
            <FrameLayout
                android:id="@+id/touch_zone_block1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent" />

            <!-- Khối 2: Phải trên (Weather Card / Location) -->
            <FrameLayout
                android:id="@+id/touch_zone_block2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Hàng Dưới: 1 khối Full Width (Hourly Forecast / Weather strip) -->
        <FrameLayout
            android:id="@+id/touch_zone_block3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.8"
            android:background="@android:color/transparent" />
    </LinearLayout>

</FrameLayout>
