<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_diagonal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="6dp">

    <!-- Tilted Diagonal Pill Shape (Exact Google Pixel Weather layout) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_diagonal_tilted_pill">

        <!-- Temperature (Upper Right / Center) -->
        <TextView
            android:id="@+id/tv_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="18dp"
            android:includeFontPadding="false"
            android:text="@string/sample_temp_11"
            android:textColor="@color/widget_text_primary"
            android:textSize="54sp"
            android:fontFamily="sans-serif-light"
            android:textStyle="normal" />

        <!-- Weather Icon (Lower Left) -->
        <ImageView
            android:id="@+id/img_weather"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="18dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/sample_weather_condition"
            android:src="@drawable/ic_weather_night_cloudy" />
    </FrameLayout>
</FrameLayout>
