<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_diagonal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Mathematically Precise Tilted Pill Capsule (-45 degrees, matching Canvas drawTiltedPill) -->
    <FrameLayout
        android:layout_width="136dp"
        android:layout_height="76dp"
        android:layout_gravity="center"
        android:background="@drawable/shape_pill_primary"
        android:rotation="-45">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Left Lobe (Bottom-Left on screen after -45 deg parent rotation) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/img_weather"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/sample_weather_condition"
                    android:rotation="30"
                    android:src="@drawable/ic_weather_sunny" />
            </FrameLayout>

            <!-- Right Lobe (Top-Right on screen after -45 deg parent rotation) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tv_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:rotation="30"
                    android:text="@string/sample_temp_large"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
