<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_diagonal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="6dp">

    <!-- Vertical Stadium Pill (Google Pixel Weather 2x3 format) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_pill"
        android:backgroundTint="@color/widget_bg_primary"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- Weather Icon -->
        <ImageView
            android:id="@+id/img_weather"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/sample_weather_condition"
            android:src="@drawable/ic_weather_night_cloudy" />

        <!-- Temperature -->
        <TextView
            android:id="@+id/tv_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:text="@string/sample_temp_11"
            android:textColor="@color/widget_text_primary"
            android:textSize="44sp"
            android:fontFamily="sans-serif-light" />

        <!-- Location -->
        <TextView
            android:id="@+id/tv_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sample_location"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Condition -->
        <TextView
            android:id="@+id/tv_condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/sample_weather_condition"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
