<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quote_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="0dp">

    <!-- Card Surface Background -->
    <ImageView
        android:id="@+id/widget_quote_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_quote_card" />

    <!-- Content Container (no Spacer, uses margins and paddings) -->
    <LinearLayout
        android:id="@+id/layout_quote_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical">

        <!-- Header: Quote Mark Icon & Category Chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivQuoteIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_quote_mark" />

            <TextView
                android:id="@+id/tvQuoteCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_day_progress_chip"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Quote Body Text -->
        <TextView
            android:id="@+id/tvQuoteText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/font_quote_editorial"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:maxLines="6"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Quote Author Attribution -->
        <TextView
            android:id="@+id/tvQuoteAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
