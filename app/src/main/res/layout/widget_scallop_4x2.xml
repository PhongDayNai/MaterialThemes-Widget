<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_scallop_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Left: 12-Lobed Flower Clock -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/shape_scallop_12"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/clock_minute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_accent"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Right: Diagonal Leaf Card (Date, Weather, Alarm) -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:layout_marginStart="8dp"
        android:background="@drawable/shape_leaf_diagonal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Weather Icon & Temp -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_weather"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/sample_weather_condition"
                    android:src="@drawable/ic_weather_sunny" />

                <TextView
                    android:id="@+id/tv_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="0dp"
                    android:text="@string/sample_temp_large"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Condition -->
            <TextView
                android:id="@+id/tv_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/sample_weather_condition"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />

            <!-- Date -->
            <TextClock
                android:id="@+id/clock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:format12Hour="@string/format_clock_date_full"
                android:format24Hour="@string/format_clock_date_full"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
